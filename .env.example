#BE envs
APP_PORT=3000
NODE_ENV=development

# Overall deadline per readiness dependency (100–5000 ms).
HEALTH_CHECK_TIMEOUT_MS=1000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edu_platform
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_SCHEMA=public

# Namespace for BullMQ queues; all API instances must use the same value.
REDIS_QUEUE_PREFIX=bull
# Total deadline for adding/scheduling jobs, including connection setup (100-5000 ms).
REDIS_QUEUE_TIMEOUT_MS=1000
REDIS_HOST=localhost
REDIS_PORT=6379

# Empty means no proxy is trusted. Set only actual proxy IPs/CIDRs, comma-separated.
TRUSTED_PROXIES=
# All replicas in one environment MUST share Redis and this prefix.
RATE_LIMIT_REDIS_PREFIX=edu-platform:rate-limit
RATE_LIMIT_REDIS_TIMEOUT_MS=1000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP is lazy; these network timeouts apply to delivery attempts (100–60000 ms).
SMTP_DNS_TIMEOUT_MS=5000
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
# Inactivity timeout, not an overall deadline for the complete message.
SMTP_SOCKET_TIMEOUT_MS=10000

ACCESS_JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3001

ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=172800
JWT_ISSUER=edu-platform
JWT_AUDIENCE=edu-platform-api

INVITATION_TOKEN_SECRET=
INVITATION_DELIVERY_POLL_SECONDS=30

LOG_LEVEL=info

PASSWORD_RESET_TOKEN_SECRET=
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_DELIVERY_POLL_SECONDS=30
PASSWORD_RESET_RESPONSE_MIN_MS=200

# FE admin envs
VITE_API_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_IMAGE_MAX_MB=5
MEDIA_PDF_MAX_MB=10
MEDIA_IMAGE_MAX_PIXELS=20000000
MEDIA_IMAGE_MAX_DIMENSION=1600
MEDIA_PDF_MAX_PAGES=500
MEDIA_ORPHAN_TTL_SECONDS=86400
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
MEDIA_PDF_TIMEOUT_MS=5000

# Application drain deadline and PostgreSQL server-side query limits.
SHUTDOWN_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=1000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=10000
MEDIA_MAX_CONCURRENT=2
MEDIA_MAX_WAITING=4
MEDIA_WAIT_TIMEOUT_MS=1000
MAIL_DISPATCH_LEASE_MS=60000
MAIL_BACKLOG_WARNING_SECONDS=300
