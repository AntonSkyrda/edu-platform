{
  "name": "edu-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "pnpm -r --if-present run build",
    "dev:api": "pnpm --filter @project/contracts --filter @project/database build && pnpm --filter api start:dev",
    "db:generate": "pnpm --filter @project/database db:generate",
    "db:migrate": "pnpm --filter @project/database db:migrate",
    "db:studio": "pnpm --filter @project/database db:studio",
    "test:auth": "pnpm build && pnpm --filter api test:auth",
    "admin:create": "pnpm build && pnpm --filter api admin:create"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
