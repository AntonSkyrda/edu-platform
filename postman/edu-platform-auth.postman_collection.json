{
  "info": {
    "name": "Edu Platform — HttpOnly Cookie Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual flow: run folders 01, 02, then 03. Import and select the Local environment; fill in email addresses and passwords. After request 04, copy the invitation token from the email into invitationToken. Each request disables the cookie jar: scripts capture Set-Cookie separately for admin and user and explicitly send Cookie headers. This supports revoked-session checks; browser SameSite/Secure behavior must be tested separately. Do not run the entire collection without pausing for the email. On HTTP 429, wait 60 seconds. Do not export environments containing credentials or tokens. Folder 04 tests password recovery separately for an ACTIVE user. Set newPassword, pause after requesting the email, and copy its token into resetToken. After finishing, update userPassword to the new password."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 — Administrator and invitation",
      "description": "",
      "item": [
        {
          "name": "01 Health",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Log in as administrator",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().detail;",
                  "pm.test('Tokens are not exposed in JSON', () => { pm.expect(body).not.to.have.property('accessToken'); pm.expect(body).not.to.have.property('refreshToken'); });",
                  "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);",
                  "pm.test('Both HttpOnly cookies are set', () => { for (const name of ['access_token', 'refresh_token']) { const value = cookies.find(c => c.startsWith(name + '=')); pm.expect(value).to.be.a('string'); pm.expect(value).to.include('HttpOnly'); pm.expect(value).to.include('SameSite=Strict'); } });",
                  "if (pm.response.code === 200 && cookies.length === 2) pm.environment.set('adminCookies', cookies.map(c => c.split(';')[0]).join('; '));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Current administrator",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Cookie",
                "value": "{{adminCookies}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('ADMIN role', () => pm.expect(pm.response.json().detail.role).to.equal('ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Invite a student",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Cookie",
                "value": "{{adminCookies}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/invitations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Student\",\n  \"role\": \"STUDENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('userId', pm.response.json().detail.id);",
                  "pm.test('INVITED status', () => pm.expect(pm.response.json().detail.status).to.equal('INVITED'));"
                ]
              }
            }
          ]
        }
      ]
    },
