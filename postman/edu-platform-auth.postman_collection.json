    {
      "name": "04 — Password recovery",
      "description": "Run separately for an ACTIVE user with a known current userPassword. Set a different newPassword (8–64 characters). Pause after request 25, wait up to 30 seconds for dispatch, and copy the token from the email link fragment to resetToken. Links expire in 30 minutes; new requests are limited to once per account per 60 seconds. Update userPassword manually after completing the folder. Wait 60 seconds on HTTP 429.",
      "item": [
        {
          "name": "24 Log in before recovery",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
